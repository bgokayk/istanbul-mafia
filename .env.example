# Copy to .env locally. Never commit real IDs, tokens or service-account files.
# Test mode ALWAYS uses official Google demo ad units. App ID selects your UMP message.
MONETIZATION_MODE=test
ADMOB_APP_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=
ADMOB_TEST_DEVICE_IDS=
UMP_TEST_EEA=false

# Play Console one-time products: two non-consumables, three consumables.
IAP_PRODUCT_REMOVE_ADS=
IAP_PRODUCT_STARTER_PACK=
IAP_PRODUCT_GOLD_SMALL=
IAP_PRODUCT_GOLD_MEDIUM=
IAP_PRODUCT_GOLD_LARGE=
IAP_VALIDATOR_URL=

# SERVER ONLY. Never copied into www/ or APK.
GOOGLE_APPLICATION_CREDENTIALS=
PLAY_PACKAGE_NAME=com.lumenco.istanbulmafia
PLAY_VALIDATOR_PORT=8850
PLAY_TEST_PURCHASES_ONLY=true
PLAY_VALIDATOR_ORIGINS=https://localhost
